# Use URL-safe values for PostgreSQL credentials. Replace placeholders locally.
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=
POSTGRES_DB=iot_monitor
ADMIN_TOKEN=
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=8080
REDIS_STREAM=iot:readings
